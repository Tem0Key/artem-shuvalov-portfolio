# Server-side only. Never prefix these secrets with NEXT_PUBLIC_ or VITE_.
# Add these values to the hosting provider's server / worker environment.
RESEND_API_KEY=

# Must use a sender/domain verified in your Resend account.
# Example format: Portfolio <contact@your-verified-domain.com>
CONTACT_FROM_EMAIL=

# Optional. Defaults to shuvaloff.artyom@gmail.com.
CONTACT_TO_EMAIL=

# Optional comma-separated exact origins, without paths, for reverse proxies.
# Without this setting, the API requires Origin to match its request URL.
# Example: https://your-domain.com,https://www.your-domain.com
CONTACT_ALLOWED_ORIGINS=

# Optional: cloudflare or forwarded. Set only behind a proxy that overwrites
# the corresponding client-IP header. Blank uses a shared process-local budget.
CONTACT_TRUST_PROXY=

# The built-in rate limiter is memory-only, bounded and per process. A
# distributed rate limiter is needed when scaling to multiple instances.
# An unconfigured contact service returns 503 and offers a direct email link.
